# ---- Required ----
# Random string, 32+ characters. Signs sessions and Claude's access tokens.
# Generate one: openssl rand -base64 48
AUTH_SECRET=
# Apify API token for the OWNER account only: Apify Console -> Settings -> API & Integrations.
# Everyone else adds their own token in Settings, so searches never spend your credit.
APIFY_TOKEN=
# Postgres connection string. On Vercel, adding the Neon integration sets this for you.
DATABASE_URL=

# ---- Optional ----
# The owner account created on first start. Defaults: sksiva / sksiva.
# CHANGE THIS PASSWORD in Settings -> Account (or set OWNER_PASSWORD) before sharing the site.
OWNER_USERNAME=sksiva
OWNER_PASSWORD=sksiva
# Set to false to stop new people creating accounts on the login page.
ALLOW_SIGNUP=true
# Public address of the app, e.g. https://jobhunt.vercel.app (auto-detected if unset).
APP_URL=
# Fixed bearer token for Claude Code / header-based connectors (32+ chars). Leave blank to use OAuth only.
MCP_API_TOKEN=
# Hard cap on what one Apify run may charge, in USD (pay-per-event actors).
APIFY_MAX_CHARGE_USD=1
# Extra hosts allowed as OAuth redirect targets, comma separated (claude.ai and claude.com are built in).
OAUTH_REDIRECT_HOSTS=
# Only if a connector form asks you for a client ID and secret instead of registering itself.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Local development only: folder for the embedded database (used when DATABASE_URL is unset).
LOCAL_DB_DIR=.data/pglite
